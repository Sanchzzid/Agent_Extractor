# Copy this file to .env and edit it. Do not commit the real .env.
# Select exactly one provider: openai | gemini | anthropic
VISION_PROVIDER=openai
# Set an available vision-capable model that supports this agent's JSON
# output and temperature=0 requirements.
VISION_MODEL=REPLACE_WITH_COMPATIBLE_MODEL_ID

# Fill ONLY the key corresponding to VISION_PROVIDER.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: current cost in USD per 1,000,000 tokens.
# These values are deliberately blank until you verify provider pricing.
# VISION_INPUT_USD_PER_M=
# VISION_OUTPUT_USD_PER_M=



