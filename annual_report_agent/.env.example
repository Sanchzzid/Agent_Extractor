
LLM_BASE_URL=https://your-endpoint/v1
LLM_MODEL=your-model-name
LLM_API_KEY=


# ---------------- Optional (defaults shown; delete what you don't change) ----------------

# Model limits
# LLM_CONTEXT_TOKENS=30000
# LLM_MAX_OUTPUT_TOKENS=8000
# USE_VISION=true
# Set false only if the provider rejects the JSON response_format option
# LLM_JSON_MODE=true

# Workers: PDFs at once / sheets at once per PDF / max parallel LLM calls / uploads at once
# REPORT_WORKERS=3
# SHEET_WORKERS=4
# LLM_MAX_CONCURRENCY=8
# JOB_WORKERS=2

# Retries: invalid JSON / network errors
# LLM_JSON_RETRIES=3
# LLM_NETWORK_RETRIES=4

# Server: allowed web origins (your Firebase URL in production) and docker host port
# ALLOWED_ORIGINS=*
# BACKEND_PORT=8024
